{
  "name": "pi-slash-anywhere",
  "version": "0.1.0",
  "description": "Pi extension providing inline autocomplete and automatic expansion for slash commands, prompt templates, and skills anywhere in prompt messages.",
  "type": "module",
  "main": "extensions/index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "slash-commands",
    "autocomplete",
    "skills"
  ],
  "scripts": {
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@types/node": "^22.19.19",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
